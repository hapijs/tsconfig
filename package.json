{
    "name": "@hapi/tsconfig",
    "version": "1.0.0",
    "description": "Shared TypeScript compiler options for hapi modules",
    "keywords": [
        "hapi",
        "tsconfig",
        "typescript"
    ],
    "license": "BSD-3-Clause",
    "repository": {
